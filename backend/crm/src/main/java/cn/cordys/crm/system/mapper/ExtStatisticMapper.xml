<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cordys.crm.system.mapper.ExtStatisticMapper">

    <!--
        统计字段刷新的通用 SQL。

        这里刻意复用 CommonMapper 里已有的条件片段, 而不是另写一套筛选逻辑:
        统计字段的「更新范围条件」就是宿主表单的高级搜索结构, 「统计范围条件」就是数据源字段的
        字段对字段比较结构, 两者最终都要落成同一套 SQL, 复用才能保证与列表页看到的条数一致。

        别名约定:
          t  - 数据表 (宿主表单 / 目标表单)
          rel - 目标表单的字段值表, 关联字段所在的行
          sc_<i> - 第 i 个筛选条件对应的字段值表副本
    -->

    <!--
        指定表单上的统计字段 + 字段属性。

        走索引: sys_module_form.organization_id -> idx_organization_id 先圈出本组织的表单,
        form_key 再收一道(表单主键上没有 form_key 索引, 这里只是把范围写清楚, 真正的裁剪靠组织索引
        已经圈出的那几行), 然后按 form_id 走 sys_module_field.idx_form_id_internal_key 的前缀取字段,
        最后用主键(sys_module_field.id = sys_module_field_blob.id)拿属性。
        type 一过滤, 剩下的行数就是手工配置的统计字段数量, 通常是个位数。

        属性 JSON 里才写着「统计谁」, 这里不做 JSON 解析: 让 SQL 依赖 json_extract 既绑死数据库方言,
        解析失败(属性被改坏)时也会静默返回空结果, 不如捞回 Java 里解析并记日志。
    -->
    <select id="selectStatisticFields" resultType="cn.cordys.crm.system.dto.StatisticFieldSourceDTO">
        select mf.form_key as hostFormKey,
               f.id        as fieldId,
               b.prop      as prop
        from sys_module_form mf
                 inner join sys_module_field f on f.form_id = mf.id and f.type = #{fieldType}
                 inner join sys_module_field_blob b on b.id = f.id
        where mf.organization_id = #{orgId}
          and mf.form_key in
        <foreach collection="hostFormKeys" item="hostFormKey" open="(" separator="," close=")">
            #{hostFormKey}
        </foreach>
    </select>

    <!--
        筛选条件的 join: 自定义字段要 join 字段表, 显示字段走 refFieldConditionJoin, 业务字段不需要 join。

        调用方必须传入 conditionFieldTable / conditionBlobTable / mainDataTable / joinKey 四个属性:
        这几个表名/列名都要按查询动态变化, 不能由片段自己写死。属性值里的 ${} 会留到运行时
        再由 MyBatis 用 mapper 方法的 @Param 解析, 所以属性值写成 ${fieldTable} 这种形式是有效的。
    -->
    <sql id="conditionJoins">
        <if test="conditions != null and conditions.size() > 0">
            <foreach collection="conditions" item="condition" index="i">
                <choose>
                    <when test="condition.refFiled">
                        <include refid="cn.cordys.common.mapper.CommonMapper.refFieldConditionJoin">
                            <property name="condition" value="condition"/>
                            <property name="mainTable" value="${mainDataTable}"/>
                            <property name="mainTableAlias" value="t"/>
                            <property name="fieldTable" value="sc_${i}"/>
                        </include>
                    </when>
                    <when test="condition.customField and condition.blob">
                        left join `${conditionBlobTable}` sc_${i}
                        on sc_${i}.resource_id = ${joinKey} and sc_${i}.field_id = #{condition.name}
                    </when>
                    <when test="condition.customField">
                        left join `${conditionFieldTable}` sc_${i}
                        on sc_${i}.resource_id = ${joinKey} and sc_${i}.field_id = #{condition.name}
                    </when>
                </choose>
            </foreach>
        </if>
    </sql>

    <!-- 筛选条件本身, 多个条件之间用 searchMode (AND/OR) 连接 -->
    <sql id="conditionWhere">
        <if test="conditions != null and conditions.size() > 0">
            <trim prefix="and">
                <trim prefix="(" suffix=")" suffixOverrides="and|or">
                    <foreach collection="conditions" item="condition" index="i">
                        <choose>
                            <when test="condition.refFiled">
                                <choose>
                                    <when test="condition.customField">
                                        <include refid="cn.cordys.common.mapper.CommonMapper.moduleFieldCondition">
                                            <property name="condition" value="condition"/>
                                            <property name="column" value="sc_${i}.field_value"/>
                                        </include>
                                    </when>
                                    <otherwise>
                                        <include refid="cn.cordys.common.mapper.CommonMapper.moduleFieldCondition">
                                            <property name="condition" value="condition"/>
                                            <property name="column" value="sc_${i}.${condition.name}"/>
                                        </include>
                                    </otherwise>
                                </choose>
                            </when>
                            <when test="condition.customField">
                                <include refid="cn.cordys.common.mapper.CommonMapper.moduleFieldCondition">
                                    <property name="condition" value="condition"/>
                                    <property name="column" value="sc_${i}.field_value"/>
                                </include>
                            </when>
                            <otherwise>
                                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                                    <property name="condition" value="condition"/>
                                    <property name="column" value="t.${condition.name}"/>
                                </include>
                            </otherwise>
                        </choose>
                        <include refid="cn.cordys.common.mapper.CommonMapper.searchMode">
                            <property name="searchMode" value="searchMode"/>
                        </include>
                    </foreach>
                </trim>
            </trim>
        </if>
    </sql>

    <!--
        宿主表单数据ID的游标分页。
        只 select 主键, 不 select 业务列, 让这一页查询尽量走聚簇索引;
        用 t.id > lastId 而不是 offset, 大数据量下每页代价恒定。
    -->
    <select id="selectDataIdsByCursor" resultType="java.lang.String">
        select t.id
        from `${dataTable}` t
        <include refid="conditionJoins">
            <property name="mainDataTable" value="${dataTable}"/>
            <property name="conditionFieldTable" value="${fieldTable}"/>
            <property name="conditionBlobTable" value="${fieldBlobTable}"/>
            <property name="joinKey" value="t.id"/>
        </include>
        where t.organization_id = #{orgId}
        <if test="lastId != null and lastId != ''">
            and t.id &gt; #{lastId}
        </if>
        <include refid="conditionWhere"/>
        order by t.id
        limit #{limit}
    </select>

    <!--
        被聚合的值的来源, 两种可能:

        1. 业务字段(定义在主表上的标准字段): 值就在目标表单主表的列上, 例如「商机金额」是 amount。
           这类字段字段值表里根本没有它的行, 去 join 只会 join 出空。
        2. 自定义字段: 值在目标表单的字段值表里, 用 field_id 关联出来的 stat.field_value。

        列名来自 BusinessModuleField 枚举(闭集), 且已由调用方转成下划线形式(枚举里写的是 planAmount,
        主表列叫 plan_amount), 拼接前还会再卡一道字符集校验。
    -->
    <sql id="statisticValue">
        <choose>
            <when test="statisticBusinessKey != null and statisticBusinessKey != ''">
                t.`${statisticBusinessKey}`
            </when>
            <otherwise>
                stat.field_value
            </otherwise>
        </choose>
    </sql>

    <!--
        目标表单的聚合: 目标表单里「关联字段指向宿主数据ID」的那些行, 就是被统计的数据。

        关联字段和被统计字段各有两种存法, 决定了要不要碰字段值表:

          (业务关联, 业务取值)   字段值表一次都不碰
          (业务关联, 自定义取值) 字段值表一次, 只用来取值
          (自定义关联, 业务取值) 字段值表一次, 只用来找关联行
          (自定义关联, 自定义取值) 字段值表两次, 找关联行 + 取值

        前两行是最常见的情形: 统计字段的数据源都是标准模块上的「客户」「合同」这类关联, 被统计的也多是
        「金额」这类标准字段, 整条语句就只剩目标表单主表自己, 字段值表一次都不进。

        字段值表最多被引用两次, 是因为关联和取值本来就是同一张表里两行不同的记录(一个 field_id
        存关系, 另一个 field_id 存数值), 只要还要按字段取值, 这张表就绕不开。能省掉的是「关系也在主表上」
        的那一半: 那半边以前白白多扫了一整张字段值表, 还因为业务字段在字段值表里根本没有行而恒算不出值。

        组织隔离与筛选条件都锚在主表别名 t 上(条件片段里的 mainTableAlias 也是 t), 与列表页的高级搜索口径一致。
    -->
    <select id="selectAggregate" resultType="java.math.BigDecimal">
        select
        <choose>
            <when test="statisticType == 'COUNT'">
                count(distinct t.id)
            </when>
            <when test="statisticType == 'AVG' and avgSkipEmpty">
                avg(<include refid="statisticValue"/> + 0)
            </when>
            <when test="statisticType == 'AVG'">
                avg(ifnull(<include refid="statisticValue"/> + 0, 0))
            </when>
            <otherwise>
                sum(<include refid="statisticValue"/> + 0)
            </otherwise>
        </choose>
        from `${targetTable}` t
        <if test="relatedBusinessKey == null or relatedBusinessKey == ''">
            <!-- 关联字段是自定义字段: 关系只存在字段值表里, 按 field_id 找列、按 field_value 找行。
                 字段值表上没有 (field_id, field_value) 打头的索引, 这一步注定要扫, 所以能走主表列就别走这里。 -->
            inner join `${fieldTable}` rel
            on rel.resource_id = t.id
            and rel.field_id = #{relatedFieldId}
            and rel.field_value = #{dataId}
        </if>
        <if test="statisticBusinessKey == null or statisticBusinessKey == ''">
            <!-- 只有取值走字段值表时才需要这个 join; 条件与 statisticValue 片段一一对应,
                 否则会出现「语句里引用了 stat 但没 join」的拼写错误 -->
            left join `${fieldTable}` stat
            on stat.resource_id = t.id and stat.field_id = #{statisticFieldId}
        </if>
        <include refid="conditionJoins">
            <property name="mainDataTable" value="${targetTable}"/>
            <property name="conditionFieldTable" value="${fieldTable}"/>
            <property name="conditionBlobTable" value="${fieldBlobTable}"/>
            <property name="joinKey" value="t.id"/>
        </include>
        where t.organization_id = #{orgId}
        <if test="relatedBusinessKey != null and relatedBusinessKey != ''">
            <!-- 关联字段是业务字段: 关系就在主表自己的列上, 例如商机上的「客户」是 customer_id -->
            and t.`${relatedBusinessKey}` = #{dataId}
        </if>
        <include refid="conditionWhere"/>
    </select>

    <!-- 字段对字段比较条件里的右值: 宿主表单某条数据的某个字段值 -->
    <select id="selectFieldValue" resultType="java.lang.String">
        select f.field_value
        from
        <choose>
            <when test="blob">
                `${blobTable}` f
            </when>
            <otherwise>
                `${fieldTable}` f
            </otherwise>
        </choose>
        where f.resource_id = #{resourceId} and f.field_id = #{fieldId}
        limit 1
    </select>

    <!--
        业务字段的值: 直接在数据表自己的列上取, 不经过字段值表。
        列名来自 BusinessModuleField 枚举(闭集), 不是外部输入; 调用方拼进来之前已经校过字符集。
    -->
    <select id="selectBusinessFieldValue" resultType="java.lang.String">
        select `${column}`
        from `${dataTable}`
        where id = #{id}
        limit 1
    </select>

    <delete id="deleteFieldValue">
        delete from `${fieldTable}` where field_id = #{fieldId} and resource_id = #{resourceId}
    </delete>

    <insert id="insertFieldValue">
        insert into `${fieldTable}` (id, resource_id, field_id, field_value)
        values (#{id}, #{resourceId}, #{fieldId}, #{fieldValue})
    </insert>

    <delete id="deleteFieldValuesByFieldId">
        delete from `${fieldTable}` where field_id = #{fieldId}
    </delete>

</mapper>
